<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes +FollowSymLinks
    </IfModule>

    RewriteEngine On

    # Shared hosting: if document root is the Laravel project folder
    # (…/alf) instead of …/alf/public, send all traffic into /public.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
